# =============================================================
# AETHER AI Platform — Environment Variables
# =============================================================

# --- Kimi-K3 (MoonshotAI) ---
# Получить ключ: https://platform.kimi.ai
# Обязательно пополните баланс минимум на $1 для активации
KIMI_API_KEY=

# --- AETHER Local Engine ---
# Если есть локальный Ollama — укажите URL (по умолчанию уже задан)
OLLAMA_URL=http://localhost:11434

# --- Опционально: vLLM ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=token-vllm

# --- Tavily Web Search (опционально) ---
# Бесплатный ключ: https://tavily.com (работает без ключа через DuckDuckGo fallback)
TAVILY_API_KEY=

# --- Embeddings Performance ---
# Установите 1 чтобы использовать быстрый хэш-эмбеддинг (без загрузки 90MB модели)
# Установите 0 для высококачественных плотных семантических эмбеддингов (рекомендуется при наличии RAM)
AETHER_SKIP_SENTENCE_TRANSFORMERS=0
